{
  "name": "@temelj/workflow",
  "version": "0.0.0-alpha.5",
  "description": "Durable, vendor-agnostic, extendible workflows.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tinrab/temelj"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.mts",
      "import": "./dist/mod.mjs"
    },
    "./compiled": {
      "types": "./dist/compiled.d.mts",
      "import": "./dist/compiled.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "import": "./dist/esbuild.mjs"
    },
    "./otel": {
      "types": "./dist/otel/mod.d.mts",
      "import": "./dist/otel/mod.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "import": "./dist/rolldown.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "import": "./dist/rollup.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "import": "./dist/rspack.mjs"
    },
    "./store": {
      "types": "./dist/store/mod.d.mts",
      "import": "./dist/store/mod.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "import": "./dist/webpack.mjs"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/mod.d.mts",
      "import": "./dist/cloudflare/mod.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf dist",
    "docs": "shx rm -rf docs && typedoc"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@temelj/event": "workspace:*",
    "@temelj/log": "workspace:*",
    "@temelj/standard-schema": "workspace:*",
    "@temelj/storage": "workspace:*",
    "@temelj/string": "workspace:*",
    "@temelj/value": "workspace:*",
    "oxc-parser": "0.154.0",
    "temporal-polyfill": "^1.0.6",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@rspack/core": "^2.2.9",
    "@types/node": "26.6.5",
    "esbuild": "^0.28.2",
    "rolldown": "^1.2.14",
    "rollup": "^4.64.6",
    "shx": "^0.4.0",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "webpack": "^5.111.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.0.0 || ^5.0.0",
    "@rspack/core": "^2.0.0",
    "esbuild": "^0.28.0",
    "rolldown": "^1.0.0",
    "rollup": "^4.0.0",
    "vite": "^8.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}
