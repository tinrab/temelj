{
  "name": "@temelj/audio",
  "version": "0.1.0",
  "description": "Utilities for working with Web Audio API. Typed Web Audio graphs, instruments, effects, and scheduling.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tinrab/temelj"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.mts",
      "import": "./dist/mod.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf dist"
  },
  "dependencies": {
    "@temelj/event": "workspace:*",
    "@temelj/value": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "shx": "^0.4.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
