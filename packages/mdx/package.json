{
  "name": "@temelj/mdx",
  "version": "0.17.0",
  "description": "MDX parsing, formatting, compilation, safe rendering, and streaming.",
  "keywords": [
    "markdown",
    "mdx",
    "rendering",
    "streaming"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tinrab/temelj"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.mts",
      "import": "./dist/mod.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins/mod.d.mts",
      "import": "./dist/plugins/mod.mjs"
    },
    "./unified": {
      "types": "./dist/unified/mod.d.mts",
      "import": "./dist/unified/mod.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.mts",
      "import": "./dist/vite-plugin.mjs"
    },
    "./rollup-plugin": {
      "types": "./dist/rollup-plugin.d.mts",
      "import": "./dist/rollup-plugin.mjs"
    },
    "./rolldown-plugin": {
      "types": "./dist/rolldown-plugin.d.mts",
      "import": "./dist/rolldown-plugin.mjs"
    },
    "./webpack-plugin": {
      "types": "./dist/webpack-plugin.d.mts",
      "import": "./dist/webpack-plugin.mjs"
    },
    "./rspack-plugin": {
      "types": "./dist/rspack-plugin.d.mts",
      "import": "./dist/rspack-plugin.mjs"
    },
    "./rsbuild-plugin": {
      "types": "./dist/rsbuild-plugin.d.mts",
      "import": "./dist/rsbuild-plugin.mjs"
    },
    "./esbuild-plugin": {
      "types": "./dist/esbuild-plugin.d.mts",
      "import": "./dist/esbuild-plugin.mjs"
    },
    "./farm-plugin": {
      "types": "./dist/farm-plugin.d.mts",
      "import": "./dist/farm-plugin.mjs"
    },
    "./bun-plugin": {
      "types": "./dist/bun-plugin.d.mts",
      "import": "./dist/bun-plugin.mjs"
    },
    "./loader": {
      "types": "./dist/loader.d.mts",
      "import": "./dist/loader.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "script:generate-entities": "node --import tsx/esm ./scripts/generate-character-entities.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf dist"
  },
  "dependencies": {
    "@temelj/standard-schema": "workspace:*",
    "@temelj/string": "workspace:*",
    "@temelj/value": "workspace:*",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "smol-toml": "1.9.1",
    "unplugin": "^3.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@shikijs/rehype": "4.5.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "property-information": "7.2.0",
    "rehype-slug": "6.0.0",
    "remark-toc": "9.0.0",
    "shiki": "4.5.0",
    "shx": "^0.4.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "property-information": "7.2.0",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "property-information": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "unified": {
      "optional": true
    },
    "vfile": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
