{
  "name": "@temelj/mdx",
  "version": "0.15.0",
  "description": "MDX parsing, formatting, compilation, safe rendering, and streaming.",
  "keywords": [
    "markdown",
    "mdx",
    "rendering",
    "streaming"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tinrab/temelj"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.mts",
      "import": "./dist/mod.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins/mod.d.mts",
      "import": "./dist/plugins/mod.mjs"
    },
    "./unified": {
      "types": "./dist/unified/mod.d.mts",
      "import": "./dist/unified/mod.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "script:generate-entities": "node --import tsx/esm ./scripts/generate-character-entities.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf dist",
    "bench": "pnpm run build && tsx benches/mdx.ts",
    "bench:fetch-fixtures": "tsx benches/fetch-fixtures.ts",
    "bench:verify": "pnpm bench --verify",
    "bench:parse": "pnpm bench --suite parse",
    "bench:html": "pnpm bench --suite html",
    "bench:compile": "pnpm bench --suite compile",
    "bench:stream": "pnpm bench --suite stream"
  },
  "dependencies": {
    "@temelj/standard-schema": "workspace:*",
    "@temelj/string": "workspace:*",
    "@temelj/value": "workspace:*",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@tanstack/markdown": "1.0.0",
    "@types/node": "26.6.5",
    "parse5": "8.0.1",
    "property-information": "7.2.0",
    "rehype-slug": "6.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-html": "16.0.1",
    "remark-toc": "9.0.0",
    "shiki": "4.5.0",
    "shx": "^0.4.0",
    "source-map": "0.8.0",
    "tinybench": "6.2.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "property-information": "7.2.0",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "vfile": "6.0.3"
  },
  "peerDependenciesMeta": {
    "property-information": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "unified": {
      "optional": true
    },
    "vfile": {
      "optional": true
    }
  }
}
