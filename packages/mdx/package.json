{
  "name": "@temelj/mdx",
  "version": "0.15.0",
  "description": "MDX processing utilities.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tinrab/temelj"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.mts",
      "import": "./dist/mod.mjs"
    },
    "./unified": {
      "types": "./dist/unified/mod.d.mts",
      "import": "./dist/unified/mod.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "script:generate-entities": "node --import tsx/esm ./scripts/generate-character-entities.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf dist"
  },
  "dependencies": {
    "@temelj/string": "workspace:*",
    "@temelj/value": "workspace:*",
    "acorn": "8.18.0",
    "acorn-jsx": "5.3.2",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@shikijs/rehype": "4.4.3",
    "@types/node": "26.3.0",
    "property-information": "7.2.0",
    "rehype-slug": "6.0.0",
    "remark-toc": "9.0.0",
    "shiki": "4.4.3",
    "shx": "^0.4.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "property-information": "7.2.0",
    "unified": "11.0.5",
    "vfile": "6.0.3"
  },
  "peerDependenciesMeta": {
    "property-information": {
      "optional": true
    },
    "unified": {
      "optional": true
    },
    "vfile": {
      "optional": true
    }
  }
}
