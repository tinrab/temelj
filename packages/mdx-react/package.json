{
  "name": "@temelj/mdx-react",
  "version": "0.16.0",
  "description": "React utilities for MDX.",
  "keywords": [
    "markdown",
    "mdx",
    "react",
    "rendering",
    "streaming"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tinrab/temelj"
  },
  "files": [
    "dist",
    "mdx.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.mts",
      "import": "./dist/mod.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs"
    },
    "./mdx": {
      "types": "./mdx.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf dist",
    "measure:bundles": "tsx scripts/measure-bundles.ts"
  },
  "dependencies": {
    "@temelj/mdx": "workspace:*",
    "@temelj/standard-schema": "workspace:*",
    "@temelj/value": "workspace:*",
    "property-information": "7.2.0",
    "style-to-js": "2.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shx": "^0.4.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
