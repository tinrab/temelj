{
  "name": "@temelj/example-workflow-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "prelocal": "pnpm --filter @temelj/workflow build",
    "local": "tsx src/local.ts",
    "predev": "pnpm --filter @temelj/workflow build",
    "dev": "wrangler dev",
    "predeploy": "pnpm --filter @temelj/workflow build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temelj/standard-schema": "workspace:*",
    "@temelj/value": "workspace:*",
    "@temelj/workflow": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "packageManager": "pnpm@12.16.1"
}
